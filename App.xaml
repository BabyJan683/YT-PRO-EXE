<Application x:Class="YTDownloaderPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:YTDownloaderPro.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design -->
                <md:BundledTheme BaseTheme="Dark" PrimaryColor="Red" SecondaryColor="Amber"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converters -->
            <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
            <conv:StatusToIconConverter x:Key="StatusIconConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:BytesToSizeConverter x:Key="BytesSizeConverter"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringVisConverter"/>
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVisConverter"/>
            <conv:EqualityConverter x:Key="EqConverter"/>
            <conv:MediaTypeIconConverter x:Key="MediaTypeIconConverter"/>
            <conv:ProgressToVisConverter x:Key="ProgressVisConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolVisConverter"/>

            <!-- Custom styles -->
            <Style x:Key="IDMProgressBar" TargetType="ProgressBar"
                   BasedOn="{StaticResource MaterialDesignLinearProgressBar}">
                <Setter Property="Height" Value="6"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
