<Window x:Class="YTDownloaderPro.Views.AddDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Add Download" Height="560" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Add New Download" FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- URL field -->
        <md:Card Grid.Row="1" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBox x:Name="TxtUrl"
                         md:HintAssist.Hint="Video URL (YouTube, Vimeo, TikTok, Instagram...)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,8"
                         FontSize="13"
                         TextChanged="TxtUrl_TextChanged"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Fetch Info" Click="BtnFetchInfo_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource PrimaryHueMidBrush}"
                            Margin="0,0,8,0"/>
                    <Button Content="Paste from Clipboard" Click="BtnPaste_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    <md:Snackbar x:Name="SnackFetch" Margin="16,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </md:Card>

        <!-- Video info card (shown after fetch) -->
        <md:Card Grid.Row="2" x:Name="CardVideoInfo" Padding="12"
                 Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="90" Height="56" CornerRadius="4" VerticalAlignment="Top">
                    <Border.Clip>
                        <RectangleGeometry RadiusX="4" RadiusY="4" Rect="0,0,90,56"/>
                    </Border.Clip>
                    <Image x:Name="ImgThumbnail" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock x:Name="TxtVideoTitle" FontWeight="SemiBold" FontSize="13"
                               TextWrapping="Wrap" MaxHeight="40"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtDuration" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtUploader" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="TxtPlaylistInfo" FontSize="12"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                   Margin="12,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- Options -->
        <md:Card Grid.Row="3" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="8"/>
                    <RowDefinition/>
                    <RowDefinition Height="8"/>
                    <RowDefinition/>
                    <RowDefinition Height="8"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Media Type" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" x:Name="CmbMediaType"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          SelectionChanged="CmbMediaType_SelectionChanged">
                    <ComboBoxItem Content="Video + Audio" Tag="Video" IsSelected="True"/>
                    <ComboBoxItem Content="Audio Only (MP3)" Tag="Audio"/>
                    <ComboBoxItem Content="Audio Only (FLAC)" Tag="AudioFlac"/>
                    <ComboBoxItem Content="Audio Only (WAV)" Tag="AudioWav"/>
                    <ComboBoxItem Content="Video Only (No audio)" Tag="VideoOnly"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Text="Quality" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbQuality"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                    <ComboBoxItem Content="Best Available" Tag="bestvideo+bestaudio/best" IsSelected="True"/>
                    <ComboBoxItem Content="4K (2160p)" Tag="bestvideo[height&lt;=2160]+bestaudio/best"/>
                    <ComboBoxItem Content="1440p" Tag="bestvideo[height&lt;=1440]+bestaudio/best"/>
                    <ComboBoxItem Content="1080p" Tag="bestvideo[height&lt;=1080]+bestaudio/best"/>
                    <ComboBoxItem Content="720p" Tag="bestvideo[height&lt;=720]+bestaudio/best"/>
                    <ComboBoxItem Content="480p" Tag="bestvideo[height&lt;=480]+bestaudio/best"/>
                    <ComboBoxItem Content="360p" Tag="bestvideo[height&lt;=360]+bestaudio/best"/>
                    <ComboBoxItem Content="Worst (smallest)" Tag="worstvideo+worstaudio/worst"/>
                </ComboBox>

                <TextBlock Grid.Row="4" Text="Format" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbFormat"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                    <ComboBoxItem Content="MP4" Tag="mp4" IsSelected="True"/>
                    <ComboBoxItem Content="MKV" Tag="mkv"/>
                    <ComboBoxItem Content="WebM" Tag="webm"/>
                    <ComboBoxItem Content="AVI" Tag="avi"/>
                    <ComboBoxItem Content="MOV" Tag="mov"/>
                </ComboBox>

                <TextBlock Grid.Row="6" Text="Save to" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Grid.Row="6" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSavePath"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Browse" Click="BtnBrowse_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="6,0,0,0"/>
                </Grid>
            </Grid>
        </md:Card>

        <!-- Scheduler option -->
        <md:Card Grid.Row="4" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox x:Name="ChkSchedule" Content="Schedule Download"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Checked="ChkSchedule_Changed" Unchecked="ChkSchedule_Changed"/>
                <StackPanel x:Name="PnlSchedule" Orientation="Horizontal"
                            Margin="24,8,0,0" Visibility="Collapsed">
                    <DatePicker x:Name="DpSchedule"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                SelectedDate="{x:Static system:DateTime.Today}"
                                xmlns:system="clr-namespace:System;assembly=mscorlib"
                                Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtScheduleTime"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="HH:MM"
                             Width="80" Text="12:00"/>
                </StackPanel>
                <CheckBox x:Name="ChkPlaylist"
                          Content="Download as Playlist (if URL is a playlist)"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Margin="0,4,0,0"/>
            </StackPanel>
        </md:Card>

        <!-- Advanced formats grid (after fetch) -->
        <md:Card Grid.Row="5" x:Name="CardFormats" Padding="8"
                 Margin="0,0,0,12" Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Available Formats"
                           FontWeight="SemiBold" Margin="4,0,0,6"/>
                <ListView x:Name="LvFormats" MaxHeight="140"
                          SelectionChanged="LvFormats_SelectionChanged"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Quality" Width="80" DisplayMemberBinding="{Binding QualityLabel}"/>
                            <GridViewColumn Header="Format" Width="60" DisplayMemberBinding="{Binding Extension}"/>
                            <GridViewColumn Header="Resolution" Width="100" DisplayMemberBinding="{Binding Resolution}"/>
                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding FileSizeDisplay}"/>
                            <GridViewColumn Header="Codec" Width="80" DisplayMemberBinding="{Binding VideoCodec}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </md:Card>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="BtnCancel_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button x:Name="BtnDownload" Content="Start Download" Click="BtnDownload_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
