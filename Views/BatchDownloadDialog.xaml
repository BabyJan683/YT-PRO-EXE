<Window x:Class="YTDownloaderPro.Views.BatchDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Batch Download" Height="480" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Batch Download" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="0" Text="Paste one URL per line:" Margin="0,32,0,8"
                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>

        <TextBox Grid.Row="1" x:Name="TxtUrls"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 md:HintAssist.Hint="https://www.youtube.com/watch?v=...&#x0a;https://vimeo.com/..."
                 FontFamily="Consolas" FontSize="12"/>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CmbQuality"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      md:HintAssist.Hint="Quality" Margin="0,0,8,0">
                <ComboBoxItem Content="Best" Tag="bestvideo+bestaudio/best" IsSelected="True"/>
                <ComboBoxItem Content="1080p" Tag="bestvideo[height&lt;=1080]+bestaudio/best"/>
                <ComboBoxItem Content="720p" Tag="bestvideo[height&lt;=720]+bestaudio/best"/>
                <ComboBoxItem Content="480p" Tag="bestvideo[height&lt;=480]+bestaudio/best"/>
                <ComboBoxItem Content="Audio only" Tag="bestaudio/best"/>
            </ComboBox>
            <ComboBox Grid.Column="1" x:Name="CmbFormat"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      md:HintAssist.Hint="Format" Margin="0,0,8,0">
                <ComboBoxItem Content="MP4" Tag="mp4" IsSelected="True"/>
                <ComboBoxItem Content="MKV" Tag="mkv"/>
                <ComboBoxItem Content="MP3" Tag="mp3"/>
                <ComboBoxItem Content="FLAC" Tag="flac"/>
            </ComboBox>
            <TextBox Grid.Column="2" x:Name="TxtSavePath"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     md:HintAssist.Hint="Save folder" IsReadOnly="True"
                     MouseLeftButtonUp="TxtSavePath_Click"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TxtUrlCount" VerticalAlignment="Center" Margin="0,0,16,0"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            <Button Content="Cancel" Click="BtnCancel_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="Add All Downloads" Click="BtnAddAll_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource PrimaryHueMidBrush}"/>
        </StackPanel>
    </Grid>
</Window>
