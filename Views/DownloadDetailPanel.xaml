<UserControl x:Class="YTDownloaderPro.Views.DownloadDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:YTDownloaderPro.Converters">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="16,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Thumbnail -->
        <Border Width="70" Height="44" CornerRadius="4">
            <Border.Clip>
                <RectangleGeometry RadiusX="4" RadiusY="4" Rect="0,0,70,44"/>
            </Border.Clip>
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
        </Border>

        <!-- Details -->
        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding Url}" FontSize="11"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           TextTrimming="CharacterEllipsis" MaxWidth="400"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock FontSize="11" Margin="0,0,12,0">
                    <Run Text="Quality: "/>
                    <Run Text="{Binding Quality}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock FontSize="11" Margin="0,0,12,0">
                    <Run Text="Format: "/>
                    <Run Text="{Binding Format}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock FontSize="11" Margin="0,0,12,0">
                    <Run Text="Speed: "/>
                    <Run Text="{Binding SpeedDisplay}" FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </TextBlock>
                <TextBlock FontSize="11" Margin="0,0,12,0">
                    <Run Text="ETA: "/>
                    <Run Text="{Binding Eta}"/>
                </TextBlock>
                <TextBlock FontSize="11">
                    <Run Text="Size: "/>
                    <Run Text="{Binding DownloadedSize}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalSize}"/>
                </TextBlock>
            </StackPanel>
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                         Margin="0,4,0,0"
                         Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                         Style="{StaticResource MaterialDesignLinearProgressBar}"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold"
                       Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding CreatedAt, StringFormat='Added: {0:MM/dd HH:mm}'}"
                       FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
