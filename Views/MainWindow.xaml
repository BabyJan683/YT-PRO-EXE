<Window x:Class="YTDownloaderPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:YTDownloaderPro.Views"
        xmlns:vm="clr-namespace:YTDownloaderPro.ViewModels"
        xmlns:conv="clr-namespace:YTDownloaderPro.Converters"
        Title="YT Downloader Pro"
        Height="750" Width="1200"
        MinHeight="550" MinWidth="900"
        WindowStartupLocation="Manual"
        Background="{DynamicResource MaterialDesignPaper}"
        Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="Segoe UI"
        FontSize="13"
        Icon="/Resources/app.ico"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">

    <Window.Resources>
        <conv:StatusToColorConverter x:Key="StatusColorConverter"/>
        <conv:StatusToIconConverter x:Key="StatusIconConverter"/>
        <conv:ProgressToWidthConverter x:Key="ProgressWidthConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:BytesToSizeConverter x:Key="BytesSizeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolVisConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title bar -->
            <RowDefinition Height="Auto"/>
            <!-- Menu bar -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- URL bar -->
            <RowDefinition Height="*"/>
            <!-- Main content -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- === CUSTOM TITLE BAR === -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueDarkBrush}" Height="36"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App icon + title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Image Source="/Resources/app.ico" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="YT Downloader Pro" Foreground="White"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text=" v2.0" Foreground="#AAFFFFFF"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Width="46" Height="36" Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnMaximize" Width="46" Height="36" Content="&#xE922;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" Click="BtnMaximize_Click"/>
                    <Button x:Name="BtnClose" Width="46" Height="36" Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" Click="BtnClose_Click"
                            md:ButtonAssist.CornerRadius="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- === MENU BAR === -->
        <Menu Grid.Row="1" Background="{DynamicResource MaterialDesignCardBackground}"
              Foreground="{DynamicResource MaterialDesignBody}" FontSize="12"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">

            <!-- FILE -->
            <MenuItem Header="_File">
                <MenuItem Header="Add New Download..." InputGestureText="Ctrl+N"
                          Command="{Binding AddDownloadCommand}">
                    <MenuItem.Icon><Image Source="/Resources/app.ico" Width="14" Height="14"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Paste URL" InputGestureText="Ctrl+V"
                          Command="{Binding PasteAndDownloadCommand}"/>
                <MenuItem Header="Batch Download..." Click="MenuBatchDownload_Click"/>
                <Separator/>
                <MenuItem Header="Open Downloads Folder" Click="MenuOpenFolder_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="MenuExit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>

            <!-- DOWNLOADS -->
            <MenuItem Header="_Downloads">
                <MenuItem Header="Start All" Command="{Binding ResumeAllCommand}"/>
                <MenuItem Header="Pause All" Command="{Binding PauseAllCommand}"/>
                <Separator/>
                <MenuItem Header="Clear Completed" Command="{Binding ClearCompletedCommand}"/>
                <MenuItem Header="Remove Failed" Click="MenuRemoveFailed_Click"/>
                <Separator/>
                <MenuItem Header="Export Download List..." Click="MenuExportList_Click"/>
            </MenuItem>

            <!-- SETTINGS -->
            <MenuItem Header="_Settings">
                <MenuItem Header="Preferences..." Click="BtnSettings_Click"/>
                <MenuItem Header="License &amp; Activation..." Click="MenuLicense_Click"/>
                <Separator/>
                <MenuItem Header="Toggle Dark/Light Theme" Click="BtnThemeToggle_Click"/>
                <Separator/>
                <MenuItem Header="Start with Windows" x:Name="MenuStartWindows"
                          IsCheckable="True" Click="MenuStartWindows_Click"/>
                <MenuItem Header="Minimize to Tray" x:Name="MenuMinimizeTray"
                          IsCheckable="True" Click="MenuMinimizeTray_Click"/>
            </MenuItem>

            <!-- HELP -->
            <MenuItem Header="_Help">
                <MenuItem Header="View Crash Log" Click="MenuViewLog_Click"/>
                <MenuItem Header="Install Browser Extension" Click="MenuInstallExtension_Click"/>
                <Separator/>
                <MenuItem Header="Check for Updates..." Click="MenuCheckUpdates_Click"/>
                <MenuItem Header="Visit Website" Click="MenuVisitWebsite_Click"/>
                <Separator/>
                <MenuItem Header="About YT Downloader Pro..." Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- === TOOLBAR === -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">
            <ToolBar Background="Transparent" Padding="4,2">
                <!-- Add New Download -->
                <Button Command="{Binding AddDownloadCommand}" ToolTip="Add New Download (Ctrl+N)"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource PrimaryHueMidBrush}" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Add URL"/>
                    </StackPanel>
                </Button>

                <!-- Paste & Download -->
                <Button Command="{Binding PasteAndDownloadCommand}" ToolTip="Paste URL from clipboard"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ContentPaste" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Paste URL"/>
                    </StackPanel>
                </Button>

                <Separator/>

                <!-- Batch Download -->
                <Button Click="BtnBatchDownload_Click" ToolTip="Batch Download"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="PlaylistPlus" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Batch"/>
                    </StackPanel>
                </Button>

                <Separator/>

                <!-- Pause All -->
                <Button Command="{Binding PauseAllCommand}" ToolTip="Pause All"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="2,0">
                    <md:PackIcon Kind="PauseCircle" Width="18" Height="18"/>
                </Button>

                <!-- Resume All -->
                <Button Command="{Binding ResumeAllCommand}" ToolTip="Resume All"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="2,0">
                    <md:PackIcon Kind="PlayCircle" Width="18" Height="18"/>
                </Button>

                <Separator/>

                <!-- Clear Completed -->
                <Button Command="{Binding ClearCompletedCommand}" ToolTip="Clear Completed"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="2,0">
                    <md:PackIcon Kind="CleaningServices" Width="16" Height="16"/>
                </Button>

                <Separator/>

                <!-- Theme toggle -->
                <Button Click="BtnThemeToggle_Click" ToolTip="Toggle Dark/Light Theme"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="2,0">
                    <md:PackIcon Kind="ThemeLightDark" Width="18" Height="18"/>
                </Button>

                <!-- Settings -->
                <Button Click="BtnSettings_Click" ToolTip="Settings"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="2,0">
                    <md:PackIcon Kind="Cog" Width="18" Height="18"/>
                </Button>

                <Separator/>

                <!-- Speed display -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <md:PackIcon Kind="SpeedFast" Width="16" Height="16"
                                 Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalSpeedDisplay}" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"
                               VerticalAlignment="Center" MinWidth="80"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <md:PackIcon Kind="Download" Width="16" Height="16"
                                 Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,4,0"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding ActiveCount}"/>
                        <Run Text=" active"/>
                    </TextBlock>
                </StackPanel>
            </ToolBar>
        </Border>

        <!-- === URL INPUT BAR === -->
        <Border Grid.Row="3" Background="{DynamicResource MaterialDesignCardBackground}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <md:Card Grid.Column="0" Padding="0" UniformCornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Grid.Column="0" Kind="Link" Width="18" Height="18"
                                     Margin="10,0,6,0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBox Grid.Column="1" x:Name="TxtUrl"
                                 Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 md:HintAssist.Hint="Paste YouTube, Vimeo, TikTok, Instagram URL..."
                                 md:HintAssist.IsFloating="False"
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 VerticalContentAlignment="Center" Padding="4,6"
                                 KeyDown="TxtUrl_KeyDown"/>
                    </Grid>
                </md:Card>

                <Button Grid.Column="1" Command="{Binding AddDownloadCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource PrimaryHueMidBrush}"
                        Margin="6,0,0,0" Padding="16,0" Height="36">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Download" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Download"/>
                    </StackPanel>
                </Button>

                <ComboBox Grid.Column="2" x:Name="CmbCategory"
                          Margin="6,0,0,0" Width="130"
                          SelectedItem="{Binding CurrentCategory}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          md:HintAssist.Hint="Filter">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Downloading"/>
                    <ComboBoxItem Content="Completed"/>
                    <ComboBoxItem Content="Paused"/>
                    <ComboBoxItem Content="Failed"/>
                    <ComboBoxItem Content="Scheduled"/>
                    <ComboBoxItem Content="Video"/>
                    <ComboBoxItem Content="Audio"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- === MAIN CONTENT === -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
                <DockPanel>
                    <!-- Search box -->
                    <md:Card DockPanel.Dock="Top" Margin="8" Padding="0" UniformCornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <md:PackIcon Kind="Magnify" Width="16" Height="16" Margin="8,0,4,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     md:HintAssist.Hint="Search..."
                                     md:HintAssist.IsFloating="False"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     Padding="2,6"/>
                        </Grid>
                    </md:Card>

                    <!-- Category buttons -->
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,0">
                            <TextBlock Text="DOWNLOADS" Margin="8,12,8,4"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       LetterSpacing="2"/>

                            <local:SidebarButton Tag="All" Text="All Downloads"
                                                 Icon="DownloadMultiple"
                                                 IsSelected="{Binding CurrentCategory, Converter={StaticResource EqConverter}, ConverterParameter=All}"
                                                 Click="SidebarButton_Click"
                                                 Count="{Binding Downloads.Count}"/>
                            <local:SidebarButton Tag="Downloading" Text="Downloading"
                                                 Icon="Download"
                                                 Click="SidebarButton_Click"/>
                            <local:SidebarButton Tag="Completed" Text="Completed"
                                                 Icon="CheckCircle"
                                                 Click="SidebarButton_Click"/>
                            <local:SidebarButton Tag="Paused" Text="Paused"
                                                 Icon="PauseCircle"
                                                 Click="SidebarButton_Click"/>
                            <local:SidebarButton Tag="Failed" Text="Failed"
                                                 Icon="AlertCircle"
                                                 Click="SidebarButton_Click"/>
                            <local:SidebarButton Tag="Scheduled" Text="Scheduled"
                                                 Icon="ClockOutline"
                                                 Click="SidebarButton_Click"/>

                            <TextBlock Text="TYPES" Margin="8,12,8,4"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       LetterSpacing="2"/>
                            <local:SidebarButton Tag="Video" Text="Videos"
                                                 Icon="Video"
                                                 Click="SidebarButton_Click"/>
                            <local:SidebarButton Tag="Audio" Text="Audio Only"
                                                 Icon="Music"
                                                 Click="SidebarButton_Click"/>

                            <Separator Margin="8,8"/>

                            <!-- Quick stats -->
                            <Border Background="{DynamicResource MaterialDesignChipBackground}"
                                    CornerRadius="4" Margin="8,4" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="SESSION STATS" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               LetterSpacing="1" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Total" FontSize="11"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Downloads.Count}"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Text="Active" FontSize="11"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding ActiveCount}"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tools at bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8">
                        <Button Click="BtnCheckUpdates_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Update" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Check Updates" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnOpenDownloadsFolder_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FolderOpen" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Downloads Folder" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- Download list -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Downloads ListView -->
                <ListView x:Name="LvDownloads"
                          ItemsSource="{Binding FilteredDownloads}"
                          SelectedItem="{Binding SelectedDownload}"
                          SelectionMode="Extended"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          BorderThickness="0"
                          Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="4,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <local:DownloadItemControl DataContext="{Binding}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open File" Click="CmOpenFile_Click">
                                <MenuItem.Icon>
                                    <md:PackIcon Kind="PlayCircle"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Open Folder" Click="CmOpenFolder_Click">
                                <MenuItem.Icon>
                                    <md:PackIcon Kind="FolderOpen"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Resume" Click="CmResume_Click">
                                <MenuItem.Icon>
                                    <md:PackIcon Kind="Play"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Pause" Click="CmPause_Click">
                                <MenuItem.Icon>
                                    <md:PackIcon Kind="Pause"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Stop" Click="CmStop_Click">
                                <MenuItem.Icon>
                                    <md:PackIcon Kind="Stop"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Copy URL" Click="CmCopyUrl_Click">
                                <MenuItem.Icon>
                                    <md:PackIcon Kind="ContentCopy"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Retry" Click="CmRetry_Click">
                                <MenuItem.Icon>
                                    <md:PackIcon Kind="Refresh"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Remove" Click="CmRemove_Click">
                                <MenuItem.Icon>
                                    <md:PackIcon Kind="Delete" Foreground="Red"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Remove and Delete File" Click="CmRemoveDelete_Click" Foreground="Red">
                                <MenuItem.Icon>
                                    <md:PackIcon Kind="DeleteForever" Foreground="Red"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding FilteredDownloads.Count, Converter={StaticResource ZeroToVisConverter}}">
                    <md:PackIcon Kind="DownloadCircle" Width="80" Height="80"
                                 Foreground="{DynamicResource MaterialDesignDivider}"
                                 HorizontalAlignment="Center"/>
                    <TextBlock Text="No downloads yet" FontSize="18" Margin="0,16,0,4"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Paste a YouTube, Vimeo or any supported URL to get started"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               HorizontalAlignment="Center" FontSize="13"/>
                </StackPanel>

                <!-- Detail panel -->
                <Border Grid.Row="1" x:Name="DetailPanel"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}"
                        Visibility="Collapsed" MaxHeight="160">
                    <local:DownloadDetailPanel x:Name="DetailPanelControl"
                                               DataContext="{Binding SelectedDownload}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- === STATUS BAR === -->
        <Border Grid.Row="5" Background="{DynamicResource PrimaryHueDarkBrush}"
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="#DDFFFFFF" FontSize="12" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                    <md:PackIcon Kind="SpeedFast" Width="14" Height="14" Foreground="#AAFFFFFF" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalSpeedDisplay}" Foreground="#DDFFFFFF" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0">
                    <md:PackIcon Kind="ClipboardCheck" Width="14" Height="14" Foreground="#AAFFFFFF" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtClipboardStatus" Text="Clipboard: ON" Foreground="#AAFFFFFF" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0">
                    <md:PackIcon Kind="Web" Width="14" Height="14" Foreground="#AAFFFFFF" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtBrowserStatus" Text="Extension: ON" Foreground="#AAFFFFFF" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
