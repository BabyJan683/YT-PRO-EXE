<Window x:Class="YTDownloaderPro.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Settings — YT Downloader Pro"
        Height="640" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="Segoe UI">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left nav -->
        <Border Background="{DynamicResource PrimaryHueDarkBrush}">
            <StackPanel>
                <TextBlock Text="SETTINGS" Foreground="#AAFFFFFF" FontSize="11" FontWeight="Bold"
                           LetterSpacing="2" Margin="16,20,16,12"/>
                <ListBox x:Name="LbNav" Background="Transparent" BorderThickness="0"
                         SelectionChanged="LbNav_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#CCFFFFFF"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="General"/>
                    <ListBoxItem Content="Downloads"/>
                    <ListBoxItem Content="Connections"/>
                    <ListBoxItem Content="Interface"/>
                    <ListBoxItem Content="Scheduler"/>
                    <ListBoxItem Content="Browser"/>
                    <ListBoxItem Content="Advanced"/>
                    <ListBoxItem Content="License"/>
                    <ListBoxItem Content="About"/>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Right content -->
        <ScrollViewer Grid.Column="1" Padding="24,20">
            <StackPanel>
                <!-- General -->
                <StackPanel x:Name="PanelGeneral">
                    <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <CheckBox x:Name="ChkStartWindows" Content="Start with Windows"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>
                    <CheckBox x:Name="ChkStartMinimized" Content="Start minimized"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>
                    <CheckBox x:Name="ChkMinimizeTray" Content="Minimize to system tray"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>
                    <CheckBox x:Name="ChkCloseTray" Content="Close to system tray"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>
                    <CheckBox x:Name="ChkNotifications" Content="Show download notifications"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>
                    <CheckBox x:Name="ChkClipboard" Content="Monitor clipboard for video URLs"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>
                    <CheckBox x:Name="ChkVideoPopup" Content="Show video detected popup"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>
                    <CheckBox x:Name="ChkAutoUpdate" Content="Check for updates automatically"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>

                    <TextBlock Text="Default download path" Margin="0,16,0,4" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDefaultPath"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <Button Grid.Column="1" Content="Browse" Click="BtnBrowseDefault_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Downloads -->
                <StackPanel x:Name="PanelDownloads" Visibility="Collapsed">
                    <TextBlock Text="Downloads" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Text="Max concurrent downloads" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Slider x:Name="SldConcurrent" Minimum="1" Maximum="10" Value="3"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Style="{StaticResource MaterialDesignSlider}"/>
                    <TextBlock>
                        <Run Text="Current: "/>
                        <Run Text="{Binding ElementName=SldConcurrent, Path=Value, StringFormat='{}{0:0}'}"/>
                    </TextBlock>

                    <TextBlock Text="Threads per download (aria2 connections)"
                               FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <Slider x:Name="SldThreads" Minimum="1" Maximum="32" Value="8"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Style="{StaticResource MaterialDesignSlider}"/>
                    <TextBlock>
                        <Run Text="Current: "/>
                        <Run Text="{Binding ElementName=SldThreads, Path=Value, StringFormat='{}{0:0}'}"/>
                    </TextBlock>

                    <TextBlock Text="Max retries on error" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <Slider x:Name="SldRetries" Minimum="0" Maximum="10" Value="3"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Style="{StaticResource MaterialDesignSlider}"/>

                    <CheckBox x:Name="ChkLimitSpeed" Content="Limit download speed"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,16,0,4"
                              Checked="ChkLimitSpeed_Changed" Unchecked="ChkLimitSpeed_Changed"/>
                    <StackPanel x:Name="PnlSpeedLimit" Orientation="Horizontal"
                                Margin="24,4,0,0" Visibility="Collapsed">
                        <TextBox x:Name="TxtSpeedLimit" Width="100"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="KB/s"/>
                        <TextBlock Text=" KB/s" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Separator Margin="0,16"/>
                    <TextBlock Text="Metadata &amp; Output" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkEmbedThumbnail" Content="Embed thumbnail in file"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>
                    <CheckBox x:Name="ChkWriteSubtitles" Content="Write subtitles (SRT)"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>
                    <CheckBox x:Name="ChkEmbedSubtitles" Content="Embed subtitles in video"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>
                    <TextBox x:Name="TxtSubLangs"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Subtitle languages (e.g. en,fr,de)"
                             Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Connections -->
                <StackPanel x:Name="PanelConnections" Visibility="Collapsed">
                    <TextBlock Text="Connections &amp; Proxy" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <CheckBox x:Name="ChkProxy" Content="Use proxy"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"
                              Checked="ChkProxy_Changed" Unchecked="ChkProxy_Changed"/>
                    <StackPanel x:Name="PnlProxy" Margin="24,8,0,0" Visibility="Collapsed">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtProxyAddress"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     md:HintAssist.Hint="Proxy address"/>
                            <TextBox Grid.Column="1" x:Name="TxtProxyPort"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     md:HintAssist.Hint="Port" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBox x:Name="TxtProxyUser"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Username (optional)" Margin="0,4"/>
                        <PasswordBox x:Name="TxtProxyPass"
                                     Style="{StaticResource MaterialDesignPasswordBox}"
                                     md:HintAssist.Hint="Password (optional)" Margin="0,4"/>
                    </StackPanel>

                    <Separator Margin="0,16"/>
                    <TextBlock Text="Cookies" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkCookies" Content="Use cookies for authentication"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"
                              Checked="ChkCookies_Changed" Unchecked="ChkCookies_Changed"/>
                    <StackPanel x:Name="PnlCookies" Margin="24,4,0,0" Visibility="Collapsed">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCookiesFile"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     md:HintAssist.Hint="Cookies file (Netscape format)"/>
                            <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                    Click="BtnBrowseCookies_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </Grid>
                        <ComboBox x:Name="CmbCookiesBrowser"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  md:HintAssist.Hint="Or use cookies from browser"
                                  Margin="0,8">
                            <ComboBoxItem Content="(None)"/>
                            <ComboBoxItem Content="Chrome" Tag="chrome"/>
                            <ComboBoxItem Content="Firefox" Tag="firefox"/>
                            <ComboBoxItem Content="Edge" Tag="edge"/>
                            <ComboBoxItem Content="Brave" Tag="brave"/>
                            <ComboBoxItem Content="Opera" Tag="opera"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Interface -->
                <StackPanel x:Name="PanelInterface" Visibility="Collapsed">
                    <TextBlock Text="Interface" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbDark" Content="Dark"
                                     GroupName="Theme"
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     Margin="0,0,16,0"/>
                        <RadioButton x:Name="RbLight" Content="Light"
                                     GroupName="Theme"
                                     Style="{StaticResource MaterialDesignRadioButton}"/>
                    </StackPanel>
                    <TextBlock Text="Accent Color" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <ComboBox x:Name="CmbAccent"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Width="200"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="Red" Tag="Red"/>
                        <ComboBoxItem Content="Blue" Tag="Blue"/>
                        <ComboBoxItem Content="Green" Tag="Green"/>
                        <ComboBoxItem Content="Orange" Tag="Orange"/>
                        <ComboBoxItem Content="Purple" Tag="Purple"/>
                        <ComboBoxItem Content="Teal" Tag="Teal"/>
                        <ComboBoxItem Content="Pink" Tag="Pink"/>
                    </ComboBox>
                </StackPanel>

                <!-- Scheduler -->
                <StackPanel x:Name="PanelScheduler" Visibility="Collapsed">
                    <TextBlock Text="Download Scheduler" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <CheckBox x:Name="ChkSchedulerEnable"
                              Content="Enable scheduled downloading window"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4"/>
                    <TextBlock Text="Downloads will only run during the specified time window."
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Margin="0,4,0,16" FontSize="12"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start time:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtScheduleStart"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="HH:MM" Text="02:00"/>
                        <TextBlock Grid.Column="2" Text="Stop time:" VerticalAlignment="Center"
                                   Margin="16,0,12,0"/>
                        <TextBox Grid.Column="3" x:Name="TxtScheduleStop"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="HH:MM" Text="06:00"/>
                    </Grid>
                </StackPanel>

                <!-- Browser -->
                <StackPanel x:Name="PanelBrowser" Visibility="Collapsed">
                    <TextBlock Text="Browser Integration" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <md:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Browser Extension" FontWeight="SemiBold"/>
                            <TextBlock Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,8"
                                       TextWrapping="Wrap">
                                Install the browser extension to detect videos while you browse.
                                The extension communicates with YT Downloader Pro on port 9614.
                            </TextBlock>
                            <Button Content="How to install extension" Click="BtnExtensionHelp_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>
                    </md:Card>
                </StackPanel>

                <!-- Advanced -->
                <StackPanel x:Name="PanelAdvanced" Visibility="Collapsed">
                    <TextBlock Text="Advanced" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Text="yt-dlp path" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtYtDlpPath"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                Click="BtnBrowseYtDlp_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        <Button Grid.Column="2" Content="Update" Margin="8,0,0,0"
                                Click="BtnUpdateYtDlp_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </Grid>

                    <TextBlock Text="aria2c path" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtAria2Path"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                Click="BtnBrowseAria2_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </Grid>

                    <TextBlock Text="FFmpeg path" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFfmpegPath"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                Click="BtnBrowseFfmpeg_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </Grid>

                    <CheckBox x:Name="ChkPortable" Content="Portable mode (store all data next to exe)"
                              Style="{StaticResource MaterialDesignCheckBox}" Margin="0,8"/>
                </StackPanel>

                <!-- License -->
                <StackPanel x:Name="PanelLicense" Visibility="Collapsed">
                    <TextBlock Text="License &amp; Activation" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Status Card -->
                    <md:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <md:PackIcon x:Name="LicIconStatus" Kind="ShieldCheck" Width="22" Height="22"
                                             Foreground="#4CAF50" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtLicStatus" Text="Checking..." FontSize="15"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtLicMessage"
                                       Text="" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       FontSize="12" Margin="0,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </md:Card>

                    <!-- PC Info -->
                    <TextBlock Text="PC Information" FontWeight="SemiBold" Margin="0,8,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="PC Name:" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2"/>
                        <TextBlock Grid.Column="1" x:Name="TxtPcName" FontWeight="Medium" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Text="Hardware ID:" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtHardwareId"
                                   FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2"/>
                    </Grid>

                    <Separator Margin="0,8"/>

                    <!-- Key Activation -->
                    <TextBlock Text="Activate License Key" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}"
                               FontSize="12" Margin="0,0,0,10">
                        Enter your product key below. One key can only be used on one PC.
                        Format: YTPRO-XXXX-XXXX-XXXX
                    </TextBlock>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtLicenseKey"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="YTPRO-XXXX-XXXX-XXXX"
                                 CharacterCasing="Upper"
                                 MaxLength="19"/>
                        <Button Grid.Column="1" x:Name="BtnActivate" Content="Activate"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource PrimaryHueMidBrush}"
                                Margin="8,0,0,0" MinWidth="90"
                                Click="BtnActivate_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtActivateResult" Text="" TextWrapping="Wrap"
                               FontSize="12" Margin="0,4" Visibility="Collapsed"/>

                    <Separator Margin="0,12"/>

                    <!-- Supabase (optional) -->
                    <Expander Header="Online Validation Settings (optional)" Margin="0,0,0,8">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8">
                                Connect to your Supabase project for cloud license validation.
                                Leave blank to use offline activation.
                            </TextBlock>
                            <TextBox x:Name="TxtSupabaseUrl"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     md:HintAssist.Hint="https://xxxx.supabase.co"
                                     Margin="0,0,0,8"/>
                            <TextBox x:Name="TxtSupabaseKey"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     md:HintAssist.Hint="Supabase Anon Key"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                    <TextBlock Text="About" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <md:Card Padding="20">
                        <StackPanel>
                            <TextBlock Text="YT Downloader Pro" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Version 2.0.0" Margin="0,4" FontSize="14"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <Separator Margin="0,12"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                A professional, feature-rich video downloader powered by yt-dlp and aria2.
                                Free, open-source, and designed for Windows 8.1, 10, and 11.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4">
                                <Run FontWeight="SemiBold">Open-source components: </Run>
                                <Run>yt-dlp (Unlicense), aria2 (GPL-2.0), ffmpeg (LGPL/GPL),
                                     MaterialDesignThemes (MIT), Microsoft.Data.Sqlite (MIT)</Run>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="yt-dlp GitHub" Click="BtnYtDlpGithub_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                                <Button Content="aria2 GitHub" Click="BtnAria2Github_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </md:Card>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer buttons (always visible) -->
        <Border Grid.Column="1" VerticalAlignment="Bottom"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8">
                <Button Content="Cancel" Click="BtnCancel_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                <Button Content="Save" Click="BtnSave_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource PrimaryHueMidBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
